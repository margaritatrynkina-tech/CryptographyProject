[run]
source = src
omit =
    src/gui/*
    src/gui/**/*
    src/core/security/*
    src/core/security/**/*
    src/core/clipboard/windows_protected_memory.py
    src/core/clipboard/platform_adapter.py
    src/database/db.py
    tests/test_gui_imports.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__:
    pass
show_missing = True
